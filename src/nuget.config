<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <!--Central package management requires the sources to be mapped. Only the Roslyn/Razor compiler
      toolchain comes from dotnet-tools; everything else must come from nuget.org so a package on the
      dnceng feed can't shadow one we expect from nuget.org.-->
  <packageSourceMapping>
    <packageSource key="nuget">
      <package pattern="*" />
      <package pattern="Microsoft.CodeAnalysis.*" />
      <package pattern="Microsoft.Net.Compilers.*" />
    </packageSource>
    <packageSource key="dotnet-tools">
      <package pattern="Microsoft.CodeAnalysis.*" />
      <package pattern="Microsoft.Net.Compilers.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
